type ParamMode = "list" | "range"

type ParamUI = {
  enabled: boolean
  mode: ParamMode
  // list mode
  list: string
  // range mode
  start: string
  end: string
  step: string
}
function normalizeKeyForStrategyParams(key: string, kind: string): string {
  let k = key.trim()
  if (k.startsWith("strategy.")) k = k.slice("strategy.".length)
  if (k.startsWith(kind + ".")) k = k.slice(kind.length + 1)
  return k
}

function coerceScalar(v: string): any {
  const t = (v ?? "").trim()
  if (!t) return undefined
  const low = t.toLowerCase()
  if (low === "true") return true
  if (low === "false") return false

  // number (int/float/scientific)
  const isNum = /^[-+]?\d*\.?\d+(e[-+]?\d+)?$/i.test(t)
  if (isNum) {
    const n = Number(t)
    if (!Number.isNaN(n)) return n
  }
  return t
}

function buildSingleStrategyParams(kind: string, singleParams: Record<string, string>, keys: string[]): Record<string, any> {
  const out: Record<string, any> = {}
  for (const rawKey of keys) {
    const raw = (singleParams[rawKey] ?? "").trim()

    // si l’utilisateur colle "12,26,9", on prend la 1ère valeur
    const first = raw.includes(",") ? raw.split(",")[0].trim() : raw
    const val = coerceScalar(first)
    if (val === undefined) continue

    const k = normalizeKeyForStrategyParams(rawKey, kind)
    out[k] = val
  }
  return out
}

function buildDomainsByKind(
  strategies: string[],
  optimizePortfolio: boolean,
  paramUI: Record<string, ParamUI>
) {
  const domainsByKind: Record<string, any[]> = {}

  const parseList = (s: string) =>
    s
      .split(",")
      .map((x) => x.trim())
      .filter(Boolean)
      .map((x) => {
        const n = Number(x)
        return Number.isFinite(n) ? n : x
      })

  for (const kindRaw of strategies) {
    const kind = kindRaw.toLowerCase()
    const keys = [...(STRAT_PARAM_KEYS[kind] ?? [])]
    if (optimizePortfolio) keys.push(...PORTF_KEYS)

    const items: any[] = []

    for (const key of keys) {
      const ui = paramUI[key]
      if (!ui || !ui.enabled) continue

      if (ui.mode === "range") {
        const lo = Number(ui.start)
        const hi = Number(ui.end)
        const step = Number(ui.step)
        if (
          !Number.isFinite(lo) ||
          !Number.isFinite(hi) ||
          !Number.isFinite(step) ||
          step <= 0
        )
          continue

        const allInt =
          Number.isInteger(lo) && Number.isInteger(hi) && Number.isInteger(step)

        items.push({
          key,
          kind: allInt ? "int" : "float",
          domain: [lo, hi, step],
          enabled: true,
        })
      } else {
        const vals = parseList(ui.list || PARAM_DEFAULTS[key] || "")
        if (vals.length === 0) continue
        items.push({ key, kind: "choice", domain: vals, enabled: true })
      }
    }

    domainsByKind[kind] = items
  }

  return domainsByKind
}
function getSelectedParamKeys(
  strategies: string[],
  optimizePortfolio: boolean
): string[] {
  const set = new Set<string>()
  for (const s of strategies) {
    const kind = s.toLowerCase()
    for (const k of STRAT_PARAM_KEYS[kind] ?? []) set.add(k)
  }
  if (optimizePortfolio) for (const k of PORTF_KEYS) set.add(k)
  return Array.from(set)
}

function ensureParamUI(
  paramUI: Record<string, ParamUI>,
  keys: string[]
): Record<string, ParamUI> {
  const next = { ...paramUI }
  for (const k of keys) {
    if (!next[k]) {
      next[k] = {
        enabled: true,
        mode: "list",
        list: PARAM_DEFAULTS[k] ?? "",
        start: "",
        end: "",
        step: "",
      }
    }
  }
  return next
}
function visibleParamKeys(strategies: string[], optimizePortfolio: boolean) {
  const s = new Set<string>()
  for (const kindRaw of strategies) {
    const kind = kindRaw.toLowerCase()
    for (const k of STRAT_PARAM_KEYS[kind] ?? []) s.add(k)
  }
  if (optimizePortfolio) for (const k of PORTF_KEYS) s.add(k)
  return Array.from(s)
}
