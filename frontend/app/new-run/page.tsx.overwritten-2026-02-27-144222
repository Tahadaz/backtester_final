      const domainsByKind =
        state.mode === "optimize"
          ? buildDomainsByKind(state.strategies, state.optimizePortfolio, state.paramUI)
          : {}


      const specJson: any = {
        app_version: "next_v1",
        source_key: state.dataSource === "dataset" ? "bmce" : "yfinance",
        symbols: symbolsList,
        data: {
          source: state.dataSource === "dataset" ? "bmce" : "yfinance",
          start: state.startDate || null,
          end: state.endDate || null,
          interval,
          include_windows: [],
          exclude_windows: [],
