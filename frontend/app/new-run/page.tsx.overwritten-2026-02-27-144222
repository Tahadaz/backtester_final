          // FIXED BASELINE VALUES (optimizer will override when included in domains)
          buy_pct_cash: state.buyPctCash,
          sell_pct_shares: state.sellPctShares,
          cooldown_bars: state.cooldownEnabled ? state.cooldownBars : 0,

