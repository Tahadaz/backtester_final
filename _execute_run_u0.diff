+def _safe_path_token(value: str, *, fallback: str) -> str:
+    cleaned = "".join(ch if ch.isalnum() or ch in {"-", "_", "."} else "_" for ch in str(value or ""))
+    cleaned = cleaned.strip("._-")
+    return cleaned or fallback
+
