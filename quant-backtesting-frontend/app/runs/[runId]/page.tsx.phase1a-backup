function rowSimpleHorizon(row: LeaderboardRow): SimpleHorizon | null {
  const flat = bestParamsFlatForRow(row)
  const raw =
    flat["simple_wfo.horizon"] ??
    flat["walk_forward.horizon"] ??
    flat["walk_forward.horizon_name"]
  const token = String(raw ?? "").trim().toLowerCase()
  if (token === "short" || token === "medium" || token === "long") return token
  return null
}

function rowDisplayRank(row: LeaderboardRow): number | null {
  const flat = bestParamsFlatForRow(row)
  const localRankRaw = flat["simple_wfo.rank"] ?? flat["walk_forward.rank"]
  const localRank = Number(localRankRaw)
  if (Number.isFinite(localRank) && localRank > 0) return Math.round(localRank)
  const fallback = Number(row.rank)
  if (Number.isFinite(fallback) && fallback > 0) return Math.round(fallback)
  return null
}

type MetricField = "total_return" | "win_pct" | "max_drawdown" | "sharpe"

function metricWithStrategyFallback(
  row: LeaderboardRow,
  key: MetricField,
  bestRowsByStrategy: Map<string, LeaderboardRow>
): number | null | undefined {
  const direct = row[key]
  if (direct !== null && direct !== undefined && Number.isFinite(Number(direct))) {
    return Number(direct)
  }
  const fallbackRow = bestRowsByStrategy.get(row.strategy_kind)
  if (!fallbackRow) return direct
  const fallback = fallbackRow[key]
  if (fallback !== null && fallback !== undefined && Number.isFinite(Number(fallback))) {
    return Number(fallback)
  }
  return direct
}

