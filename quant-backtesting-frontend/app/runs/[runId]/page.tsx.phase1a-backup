                          // Objective name and top-K from spec (available via optimizationSpecConfig / walkForwardSpecConfig)
                          const objectiveName = (() => {
                            const v = String(asObject(optimizationSpecConfig)?.objective ?? walkForwardSpecConfig?.objective ?? "").trim()
                            return v || null
                          })()
                          const topK = (() => {
                            const raw = walkForwardSpecConfig?.top_k ?? walkForwardSpecConfig?.k_top ?? walkForwardSpecConfig?.top_candidates
                            const n = Number(raw)
                            return Number.isFinite(n) && n > 0 ? n : null
                          })()

                          // Window config compact labels
                          const windowLabel = (w: Record<string, unknown>): string => {
                            const months = w.months ?? w.n_months
                            const years  = w.years  ?? w.n_years
                            const days   = w.days   ?? w.n_days
                            if (months != null) return `${months}mo`
                            if (years  != null) return `${years}yr`
                            if (days   != null) return `${days}d`
                            const keys = Object.keys(w)
                            if (!keys.length) return "—"
                            return `${keys[0]}=${String(w[keys[0]])}`
                          }
                          const trainLabel = walkForward?.windows?.train ? windowLabel(walkForward.windows.train) : "—"
                          const testLabel  = walkForward?.windows?.test  ? windowLabel(walkForward.windows.test)  : "—"
                          const stepLabel  = walkForward?.windows?.step  ? windowLabel(walkForward.windows.step)  : "—"

                          // Winner overlay compact string
                          const winnerOverlayStr = overlayCompact(winnerCandidate?.params ?? null)

                          // Horizon label for display
                          const horizonDisplayLabel = isSimpleWfoOptimization && selectedHorizon
                            ? SIMPLE_HORIZON_LABELS[selectedHorizon]
                            : (walkForward?.horizon_label ?? walkForward?.horizon ?? null)

                          // Per-fold OOS analysis (winner folds sorted chronologically)
                          const sortedWinnerFolds = [...winnerSelectionFolds].sort((a, b) => (a.fold_logical ?? 0) - (b.fold_logical ?? 0))
                          const profitablePeriods  = sortedWinnerFolds.filter((f) => (foldMetric(f.fold_metrics_json, "stat.pnl", "pnl") ?? -1) > 0).length
                          const totalPeriods       = sortedWinnerFolds.length
                          const cumulativePnlSteps = sortedWinnerFolds.reduce<Array<{ fold: number; cumPnl: number }>>((acc, f, i) => {
                            const pnl  = foldMetric(f.fold_metrics_json, "stat.pnl", "pnl") ?? 0
                            const prev = acc[i - 1]?.cumPnl ?? 0
                            acc.push({ fold: f.fold_logical ?? f.fold_index, cumPnl: prev + pnl })
                            return acc
                          }, [])
                          const worstFoldEntry = sortedWinnerFolds.reduce<{ fold: typeof sortedWinnerFolds[0]; pnl: number } | null>((worst, f) => {
                            const pnl = foldMetric(f.fold_metrics_json, "stat.pnl", "pnl") ?? 0
                            if (worst === null || pnl < worst.pnl) return { fold: f, pnl }
                            return worst
                          }, null)
                          const consistencyLabel = totalPeriods === 0 ? null
                            : profitablePeriods / totalPeriods > 0.75 ? "Strong"
                            : profitablePeriods / totalPeriods > 0.50 ? "Moderate"
                            : "Weak"
                          const consistencyCls = consistencyLabel === "Strong"   ? "bg-emerald-100 text-emerald-800"
                            : consistencyLabel === "Moderate" ? "bg-amber-100 text-amber-800"
                            : "bg-red-100 text-red-800"

                          // Group candidates by signal-only recipe key
                          const recipeGroups: WfoCandidateSummary[][] = (() => {
                            const map = new Map<string, WfoCandidateSummary[]>()
                            for (const c of candidateSummaries) {
                              const key = recipeKeyFor(c.params)
                              const group = map.get(key) ?? []
                              group.push(c)
                              map.set(key, group)
                            }
                            return Array.from(map.values()).sort((a, b) => {
                              const ra = Math.min(...a.map((c) => c.rank_mean ?? Infinity))
                              const rb = Math.min(...b.map((c) => c.rank_mean ?? Infinity))
                              return ra - rb
                            })
                          })()

                          return (
                            <TabsContent key={kind} value={`strategy:${kind}`}>
                              {hasUsableWfoData ? (
                                <div className="space-y-5">

                                  {/* ── Block A — Executive Verdict ────────────────────────── */}
                                  <div className="rounded-md border-2 border-primary/20 bg-background p-4 space-y-3">
                                    {/* Header row */}
                                    <div className="flex flex-wrap items-center gap-2">
                                      <p className="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Executive Verdict</p>
                                      {horizonDisplayLabel && (
                                        <span className="rounded border border-border bg-secondary/50 px-2 py-0.5 text-[10px] font-semibold text-foreground">{horizonDisplayLabel}</span>
                                      )}
                                      {consistencyLabel && (
                                        <span className={`rounded px-2 py-0.5 text-[10px] font-bold ${consistencyCls}`}>{consistencyLabel} consistency</span>
                                      )}
                                    </div>

                                    {/* Winner recipe + selection rationale */}
                                    <div className="space-y-0.5">
                                      <p className="text-sm font-bold text-foreground">{strategyOnlyPreview(winnerCandidate?.params ?? null)}</p>
                                      {winnerOverlayStr && winnerOverlayStr !== "(default overlay)" && (
                                        <p className="text-xs text-muted-foreground">Overlay: <span className="font-mono">{winnerOverlayStr}</span></p>
                                      )}
                                      {selectedWinner?.selection_reason && (
                                        <p className="text-xs text-muted-foreground">
                                          Selected via: <span className="font-medium text-foreground">{selectedWinner.selection_reason}</span>
                                        </p>
                                      )}
                                    </div>

                                    {/* OOS metrics grid */}
                                    {holdout ? (
                                      <>
                                        <p className="text-[10px] text-muted-foreground font-mono">
                                          OOS holdout: {String(holdout.test_start ?? "--").slice(0, 10)} → {String(holdout.test_end ?? "--").slice(0, 10)}
                                        </p>
                                        <div className="grid grid-cols-3 gap-2 sm:grid-cols-6">
                                          {([
                                            { label: "PnL",    value: formatNumber(holdout.pnl, 0) },
                                            { label: "CAGR",   value: formatPercent(holdout.cagr) },
                                            { label: "Sharpe", value: formatNumber(holdout.sharpe, 2) },
                                            { label: "MaxDD",  value: formatPercent(holdout.max_drawdown) },
                                            { label: "Win%",   value: formatPercent(holdout.win_pct) },
                                            { label: "Trades", value: holdout.n_fills != null ? String(holdout.n_fills) : "--" },
                                          ] as Array<{ label: string; value: string | null }>).map(({ label, value }) => (
                                            <div key={label} className="rounded-sm bg-secondary/50 px-2 py-1.5">
                                              <p className="text-[10px] uppercase text-muted-foreground">{label}</p>
                                              <p className="font-mono text-xs font-semibold text-foreground">{value ?? "--"}</p>
                                            </div>
                                          ))}
                                        </div>
                                      </>
                                    ) : (
                                      <p className="text-xs text-muted-foreground italic">OOS holdout result not available.</p>
                                    )}

                                    {/* Period profitability summary */}
                                    {totalPeriods > 0 && (
                                      <p className="text-xs text-muted-foreground">
                                        Profitable in <span className="font-semibold text-foreground">{profitablePeriods} / {totalPeriods}</span> selection periods
                                      </p>
                                    )}
                                  </div>

                                  {/* ── Block B — Selection Mechanics ──────────────────────── */}
                                  <div className="rounded-md border border-border bg-secondary/10 p-3 space-y-2">
                                    <p className="text-[10px] font-bold uppercase tracking-wider text-muted-foreground">Selection Mechanics</p>
                                    <div className="flex flex-wrap gap-2">
                                      {([
                                        { label: "Objective",   value: objectiveName ?? "—" },
                                        { label: "Candidates",  value: String(candidateSummaries.length) },
                                        { label: "Folds",       value: String(selectedWinner?.n_selection_folds ?? walkForward?.n_selection_folds ?? "—") },
                                        { label: "Top-K/fold",  value: topK != null ? String(topK) : "—" },
                                        { label: "Winner rule", value: selectedWinner?.selection_reason ?? "—" },
                                        { label: "Train",       value: trainLabel },
                                        { label: "Test (OOS)",  value: testLabel },
                                        { label: "Step",        value: stepLabel },
                                      ] as Array<{ label: string; value: string }>).map(({ label, value }) => (
                                        <div key={label} className="rounded bg-secondary/50 px-2.5 py-1.5 min-w-[60px]">
                                          <p className="text-[9px] uppercase tracking-wide text-muted-foreground">{label}</p>
                                          <p className="font-mono text-[11px] font-semibold text-foreground truncate max-w-[120px]">{value}</p>
                                        </div>
                                      ))}
                                    </div>
                                  </div>

                                  {/* ── Block C — Grouped Signal Recipes ───────────────────── */}
                                  <div>
                                    <p className="text-[10px] font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
                                      Signal Recipes
                                      {" "}({recipeGroups.length} unique{recipeGroups.length !== candidateSummaries.length ? `, ${candidateSummaries.length} total variants` : ""})
                                    </p>
                                    <div className="overflow-x-auto rounded-md border border-border">
                                      <table className="w-full text-xs">
                                        <thead>
                                          <tr className="border-b border-border bg-secondary/30">
                                            <th className="px-2 py-1.5 text-left font-semibold">Signal Recipe</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Overlays</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Folds Seen</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Best Rank</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Best Obj.</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">OOS PnL</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">OOS Sharpe</th>
                                            <th className="px-2 py-1.5 text-center font-semibold">★</th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          {recipeGroups.map((group, gi) => {
                                            const hasWinner = group.some((c) => c.is_winner)
                                            const bestRank  = Math.min(...group.map((c) => c.rank_mean ?? Infinity))
                                            const bestByRank = group.reduce((best, c) => (c.rank_mean ?? Infinity) < (best.rank_mean ?? Infinity) ? c : best, group[0])
                                            const foldsSeen  = Math.max(...group.map((c) => c.fold_count ?? 0))
                                            const recipeLabel = strategyOnlyPreview(group[0]?.params)
                                            return (
                                              <Fragment key={`recipe-${gi}`}>
                                                <tr className={`border-b border-border/40 ${hasWinner ? "bg-emerald-50/60" : "hover:bg-secondary/20"}`}>
                                                  <td className="px-2 py-1.5 font-mono text-[11px] font-semibold">{recipeLabel}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{group.length}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{foldsSeen > 0 ? foldsSeen : "—"}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{bestRank === Infinity ? "—" : formatNumber(bestRank, 2)}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{formatNumber(bestByRank?.objective_mean, 4)}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{hasWinner && holdout ? formatNumber(holdout.pnl, 0) : "—"}</td>
                                                  <td className="px-2 py-1.5 text-right font-mono">{hasWinner && holdout ? formatNumber(holdout.sharpe, 2) : "—"}</td>
                                                  <td className="px-2 py-1.5 text-center">{hasWinner ? <span className="font-bold text-emerald-600">★</span> : null}</td>
                                                </tr>
                                                {/* Overlay drill-down — native <details> avoids any state-inside-map issue */}
                                                <tr className="border-b border-border/40 bg-secondary/5">
                                                  <td colSpan={8} className="px-0 py-0">
                                                    <details>
                                                      <summary className="cursor-pointer select-none px-3 py-1.5 text-[10px] text-muted-foreground hover:text-foreground list-none flex items-center gap-1">
                                                        <span>▸</span>
                                                        <span>{group.length === 1 ? "Show overlay params" : `Show ${group.length} overlay variants`}</span>
                                                      </summary>
                                                      <div className="border-t border-border/40 overflow-x-auto">
                                                        <table className="w-full text-xs">
                                                          <thead>
                                                            <tr className="bg-secondary/20">
                                                              <th className="px-3 py-1 text-left font-semibold text-muted-foreground">Overlay Params</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">Folds</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">Obj. Mean</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">Sharpe</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">PnL Mean</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">MaxDD</th>
                                                              <th className="px-2 py-1 text-right font-semibold text-muted-foreground">Rank</th>
                                                              <th className="px-2 py-1 text-center font-semibold text-muted-foreground">★</th>
                                                            </tr>
                                                          </thead>
                                                          <tbody>
                                                            {[...group]
                                                              .sort((a, b) => (a.rank_mean ?? Infinity) - (b.rank_mean ?? Infinity))
                                                              .map((c, ci) => (
                                                                <tr key={c.trial_id || String(ci)} className={`border-t border-border/20 ${c.is_winner ? "bg-emerald-50/50" : "hover:bg-secondary/10"}`}>
                                                                  <td className="px-3 py-1 font-mono text-[10px] text-muted-foreground">{overlayCompact(c.params)}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{c.fold_count ?? "—"}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{formatNumber(c.objective_mean, 4)}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{formatNumber(c.sharpe_mean, 2)}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{formatNumber(c.pnl_mean, 0)}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{formatPercent(c.max_drawdown_mean)}</td>
                                                                  <td className="px-2 py-1 text-right font-mono">{formatNumber(c.rank_mean, 2)}</td>
                                                                  <td className="px-2 py-1 text-center">{c.is_winner ? <span className="text-emerald-600 font-bold">★</span> : null}</td>
                                                                </tr>
                                                              ))}
                                                          </tbody>
                                                        </table>
                                                      </div>
                                                    </details>
                                                  </td>
                                                </tr>
                                              </Fragment>
                                            )
                                          })}
                                        </tbody>
                                      </table>
                                    </div>
                                  </div>

                                  {/* ── Block D — OOS Period Timeline ───────────────────────── */}
                                  <div>
                                    <p className="text-[10px] font-bold uppercase tracking-wider text-muted-foreground mb-1.5">
                                      OOS Period Timeline
                                    </p>
                                    {foldAttributionUnavailable ? (
                                      <p className="rounded-md border border-border bg-secondary/20 px-3 py-4 text-center text-xs text-muted-foreground">
                                        {foldEmptyStateMessage}
                                      </p>
                                    ) : (
                                      <>
                                        <div className="overflow-x-auto rounded-md border border-border">
                                          <table className="w-full text-xs">
                                            <thead>
                                              <tr className="border-b border-border bg-secondary/30">
                                                <th className="px-2 py-1.5 text-left font-semibold">Period</th>
                                                <th className="px-2 py-1.5 text-left font-semibold">Test Dates</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">PnL</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">CAGR</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">Sharpe</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">MaxDD</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">Win%</th>
                                                <th className="px-2 py-1.5 text-right font-semibold">Trades</th>
                                                <th className="px-2 py-1.5 text-center font-semibold">Result</th>
                                              </tr>
                                            </thead>
                                            <tbody>
                                              {sortedWinnerFolds.map((fold) => {
                                                const m      = fold.fold_metrics_json
                                                const pnl    = foldMetric(m, "stat.pnl", "pnl")
                                                const sharpe = foldMetric(m, "stat.sharpe", "sharpe")
                                                const maxDD  = foldMetric(m, "stat.max_drawdown", "max_drawdown")
                                                const badge  = foldPeriodBadge(pnl, sharpe, maxDD)
                                                return (
                                                  <tr key={fold.fold_index} className="border-b border-border/40 hover:bg-secondary/20">
                                                    <td className="px-2 py-1.5 font-mono font-semibold">{fold.fold_logical ?? fold.fold_index}</td>
                                                    <td className="px-2 py-1.5 font-mono text-[10px] text-muted-foreground">
                                                      {String(fold.test_start ?? "--").slice(0, 10)} – {String(fold.test_end ?? "--").slice(0, 10)}
                                                    </td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatNumber(pnl, 0)}</td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatPercent(foldMetric(m, "stat.cagr", "cagr"))}</td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatNumber(sharpe, 2)}</td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatPercent(maxDD)}</td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatPercent(foldMetric(m, "stat.win_pct", "win_pct"))}</td>
                                                    <td className="px-2 py-1.5 text-right font-mono">{formatNumber(foldMetric(m, "n_fills"), 0) ?? "--"}</td>
                                                    <td className="px-2 py-1.5 text-center">
                                                      <span className={`inline-block rounded px-1.5 py-0.5 text-[9px] font-bold ${badge.cls}`}>{badge.label}</span>
                                                    </td>
                                                  </tr>
                                                )
                                              })}
                                            </tbody>
                                          </table>
                                        </div>

                                        {/* Cumulative OOS running sum */}
                                        {cumulativePnlSteps.length > 0 && (
                                          <div className="mt-2 flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[10px]">
                                            <span className="font-semibold text-muted-foreground uppercase tracking-wide">Cumulative OOS PnL:</span>
                                            {cumulativePnlSteps.map((s, i) => (
                                              <span key={s.fold} className={`font-mono ${s.cumPnl >= 0 ? "text-emerald-700" : "text-red-700"}`}>
                                                F{s.fold}: {s.cumPnl >= 0 ? "+" : ""}{formatNumber(s.cumPnl, 0)}{i < cumulativePnlSteps.length - 1 ? " →" : ""}
                                              </span>
                                            ))}
                                          </div>
                                        )}

                                        {/* Consistency summary */}
                                        {totalPeriods > 0 && (
                                          <p className="mt-1.5 text-[10px] text-muted-foreground">
                                            Profitable in{" "}
                                            <span className="font-semibold text-foreground">{profitablePeriods} / {totalPeriods}</span>
                                            {" "}periods ({Math.round(profitablePeriods / totalPeriods * 100)}%).
                                            {worstFoldEntry && (
                                              <>{" "}Worst: {String(worstFoldEntry.fold.test_start ?? "").slice(0, 10)}–{String(worstFoldEntry.fold.test_end ?? "").slice(0, 10)}, PnL {formatNumber(worstFoldEntry.pnl, 0)}.</>
                                            )}
                                          </p>
                                        )}
                                      </>
                                    )}
                                  </div>

                                  {/* ── Block F — Raw Audit Trail (collapsed) ──────────────── */}
                                  <details className="rounded-md border border-border">
                                    <summary className="flex cursor-pointer select-none items-center justify-between px-3 py-2 text-[10px] font-bold uppercase tracking-wider text-muted-foreground hover:text-foreground list-none">
                                      <span>Raw Candidate Audit Trail ({candidateSummaries.length} candidates)</span>
                                      <span className="normal-case font-normal">▸ expand</span>
                                    </summary>
                                    <div className="border-t border-border overflow-x-auto">
                                      <table className="w-full text-xs">
                                        <thead>
                                          <tr className="border-b border-border bg-secondary/30">
                                            <th className="px-2 py-1.5 text-left font-semibold">Variant</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Folds</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Obj. Mean</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Sharpe Mean</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">PnL Mean</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">MaxDD Mean</th>
                                            <th className="px-2 py-1.5 text-right font-semibold">Rank Mean</th>
                                            <th className="px-2 py-1.5 text-center font-semibold">★</th>
                                          </tr>
                                        </thead>
                                        <tbody>
                                          {[...candidateSummaries]
                                            .sort((a, b) => (a.rank_mean ?? Infinity) - (b.rank_mean ?? Infinity))
                                            .map((c, idx) => (
                                              <tr key={c.trial_id || String(idx)} className={`border-b border-border/40 ${c.is_winner ? "bg-emerald-50/60" : "hover:bg-secondary/20"}`}>
                                                <td className="px-2 py-1.5 font-mono text-[11px]">{strategyOnlyPreview(c.params)}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{c.fold_count ?? "--"}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{formatNumber(c.objective_mean, 4)}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{formatNumber(c.sharpe_mean, 2)}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{formatNumber(c.pnl_mean, 0)}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{formatPercent(c.max_drawdown_mean)}</td>
                                                <td className="px-2 py-1.5 text-right font-mono">{formatNumber(c.rank_mean, 2)}</td>
                                                <td className="px-2 py-1.5 text-center">{c.is_winner ? <span className="font-bold text-emerald-600">★</span> : null}</td>
                                              </tr>
                                            ))}
                                        </tbody>
                                      </table>
                                    </div>
                                  </details>

                                </div>
                              ) : (
                                /* Fallback: legacy variations table for non-WFO / old runs */
                                !strategyRows.length ? (
                                  <p className="py-6 text-center text-sm text-muted-foreground">No rows for {kind}.</p>
                                ) : (
                                  <div className="overflow-x-auto">
                                    <table className="w-full text-sm">
                                      <thead>
                                        <tr className="border-b border-border">
                                          <th className="px-2 py-2 text-left text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Strategy</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Rank</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">CAGR</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">PnL</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Total Return</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Trades</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Win %</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Max DD</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Sharpe</th>
                                          <th className="px-2 py-2 text-left text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Params (Delta vs #1)</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Details</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {strategyRows.map((row, idx) => (
                                          <tr key={`${rowKey(row)}-strategy-${idx}`} className="border-b border-border/50">
                                            <td className="px-2 py-2 text-xs font-semibold text-foreground">{row.strategy_kind}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{rowDisplayRank(row) ?? "--"}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatPercent(row.cagr)}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatNumber(row.pnl)}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatPercent(metricWithStrategyFallback(row, "total_return", bestRowsByStrategy))}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{row.n_fills ?? "--"}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatPercent(metricWithStrategyFallback(row, "win_pct", bestRowsByStrategy))}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatPercent(metricWithStrategyFallback(row, "max_drawdown", bestRowsByStrategy))}</td>
                                            <td className="px-2 py-2 text-right font-mono text-xs">{formatNumber(metricWithStrategyFallback(row, "sharpe", bestRowsByStrategy))}</td>
                                            <td className="max-w-[360px] px-2 py-2 font-mono text-[11px] leading-relaxed text-muted-foreground">
                                              <span className="line-clamp-3">
                                                {(Number(rowDisplayRank(row) ?? 1) === 1)
                                                  ? strategyOnlyPreview(row.best_params_json)
                                                  : strategyOnlyDiffPreview(row.best_params_json, strategyRows[0]?.best_params_json)}
                                              </span>
                                            </td>
                                            <td className="px-2 py-2 text-right">
                                              <Button variant="outline" size="sm" className="h-7 text-xs" onClick={() => setSelectedDetailRowKey(rowKey(row))}>Show</Button>
                                            </td>
                                          </tr>
                                        ))}
                                      </tbody>
                                    </table>
                                  </div>
                                )
                              )}
                            </TabsContent>
                          )
                        })}

                        {!isSimpleWfoOptimization && (
                          <TabsContent value="decision">
                            <div className="space-y-4">
                              <div className="flex flex-wrap items-center justify-between gap-3 rounded-md border border-border p-3">
                                <div>
                                  <p className="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Decision Framework</p>
                                  <p className="text-xs text-muted-foreground">
                                    Backend-computed opportunity/confidence ranking for this symbol.
                                  </p>
                                </div>
                                <div className="flex items-center gap-2">
                                  <Label htmlFor="decision-best-only" className="text-xs text-muted-foreground">Best only</Label>
                                  <Switch
                                    id="decision-best-only"
                                    checked={decisionBestOnly}
                                    onCheckedChange={setDecisionBestOnly}
                                  />
                                </div>
                              </div>

                              {decisionsLoading ? (
                                <div className="space-y-2">
                                  <Skeleton className="h-10 w-full" />
                                  <Skeleton className="h-10 w-full" />
                                  <Skeleton className="h-10 w-full" />
                                </div>
                              ) : !selectedSymbolDecisionRows.length ? (
                                <p className="py-6 text-center text-sm text-muted-foreground">
                                  No decision records found for {selectedSymbol}.
                                </p>
                              ) : (
                                <div className="grid gap-4 xl:grid-cols-[1.3fr_1fr]">
                                  <div className="overflow-x-auto rounded-md border border-border">
                                    <table className="w-full text-sm">
                                      <thead>
                                        <tr className="border-b border-border">
                                          <th className="px-2 py-2 text-left text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Symbol</th>
                                          <th className="px-2 py-2 text-left text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Strategy</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Opportunity</th>
                                          <th className="px-2 py-2 text-right text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Confidence</th>
                                          <th className="px-2 py-2 text-center text-[11px] font-bold uppercase tracking-wider text-muted-foreground">Status</th>
                                        </tr>
                                      </thead>
                                      <tbody>
                                        {selectedSymbolDecisionRows.map((row) => {
                                          const key = decisionRowKey(row)
                                          const isActive = selectedDecisionKey === key
                                          return (
                                            <tr
                                              key={key}
                                              className={`cursor-pointer border-b border-border/50 ${isActive ? "bg-secondary/40" : "hover:bg-secondary/20"}`}
                                              onClick={() => {
                                                void handleDecisionRowClick(row)
                                              }}
                                            >
                                              <td className="px-2 py-2 text-xs font-semibold text-foreground">{row.symbol}</td>
                                              <td className="px-2 py-2 text-xs text-foreground">{row.strategy_kind}</td>
                                              <td className="px-2 py-2 text-right font-mono text-xs">{formatNumber(row.opportunity_score, 1)}</td>
                                              <td className="px-2 py-2 text-right font-mono text-xs">{formatNumber(row.confidence_score, 1)}</td>
                                              <td className="px-2 py-2 text-center">
                                                <span className={`rounded px-2 py-0.5 text-[11px] font-semibold uppercase ${decisionStatusClass(row.status)}`}>
                                                  {row.status}
                                                </span>
                                              </td>
                                            </tr>
                                          )
                                        })}
                                      </tbody>
                                    </table>
                                  </div>

                                  {selectedDecision ? (
                                    <DecisionDashboardView
                                      decision={selectedDecision}
                                      dashboard={selectedDecisionDashboard}
                                      loading={decisionDetailLoading}
                                      walkForward={walkForward ?? null}
                                    />
                                  ) : null}
                                </div>
                              )}
                            </div>
                          </TabsContent>
                        )}
                      </Tabs>
                    </CardContent>
                  </Card>

                  {selectedDetailRow && (
                    <Card>
                      <CardHeader className="pb-3">
                        <CardTitle className="text-base">{selectedDetailRow.symbol} - {selectedDetailRow.strategy_kind} (rank {rowDisplayRank(selectedDetailRow) ?? "--"})</CardTitle>
                      </CardHeader>
                      <CardContent className="space-y-3">
                        {Number(rowDisplayRank(selectedDetailRow) ?? 1) !== 1 && (
                          <p className="rounded-md border border-border bg-secondary/30 px-3 py-2 text-xs text-muted-foreground">
                            Results below are freshly computed for this specific parameter set (rank {rowDisplayRank(selectedDetailRow) ?? "--"}).
                          </p>
                        )}
                        <SingleBacktestResults
                          runId={runId ?? ""}
                          symbol={selectedDetailRow.symbol}
                          runSpec={run.spec_json}
                          metrics={detailMetricsRows}
                          metricsLoading={metricsLoading}
                          showDecisionTab={
                            isSimpleWfoOptimization
                              ? String(selectedDetailRow.strategy_kind ?? "").trim().toLowerCase() === "sma_price"
                              : true
                          }
                          forcedStrategy={selectedDetailRow.strategy_kind}
                          strategyParamsOverride={detailGroupedParams.strategy}
                          portfolioConfigOverride={detailGroupedParams.portfolio}
                          decisionBatchRows={selectedSymbolBatchPeriodRows}
                          decisionSelectedHorizon={selectedHorizon}
                          decisionSelectedBestParamsRaw={selectedDetailRow.best_params_json}
                          decisionSameStrategyRows={selectedSymbolAllRows.filter(
                            (row) => row.strategy_kind === selectedDetailRow.strategy_kind
                          )}
                          metricOverrides={{
                            cagr: selectedDetailRow.cagr,
                            pnl: selectedDetailRow.pnl,
                            total_return: metricWithStrategyFallback(selectedDetailRow, "total_return", bestRowsByStrategy),
                            sharpe: metricWithStrategyFallback(selectedDetailRow, "sharpe", bestRowsByStrategy),
                            max_drawdown: metricWithStrategyFallback(selectedDetailRow, "max_drawdown", bestRowsByStrategy),
                            n_fills: selectedDetailRow.n_fills,
                            win_pct: metricWithStrategyFallback(selectedDetailRow, "win_pct", bestRowsByStrategy),
                          }}
                        />
                      </CardContent>
                    </Card>
                  )}
                </>
              )
            ) : (
              <SingleBacktestResults
                runId={runId ?? ""}
                symbol={effectiveSymbol}
                runSpec={run.spec_json}
                metrics={filteredMetrics}
                metricsLoading={metricsLoading}
              />
            )}
          </div>
        </div>
      ) : run.status === "running" || run.status === "queued" ? (
        <Card>
          <CardContent className="py-16 text-center">
            <div className="mx-auto mb-4 h-8 w-8 animate-spin rounded-full border-2 border-primary border-t-transparent" />
            <h3 className="font-semibold text-foreground">Run in progress</h3>
            <p className="mt-1 text-sm text-muted-foreground">Auto-refreshing every 2 seconds. Results will appear when complete.</p>
          </CardContent>
        </Card>
      ) : run.status === "created" ? (
        <Card>
          <CardContent className="py-16 text-center">
            <h3 className="font-semibold text-foreground">Ready to start</h3>
            <p className="mt-1 text-sm text-muted-foreground">Click &quot;Start Run&quot; above to begin execution.</p>
            {walkForwardConfigured && (
              <p className="mt-2 text-xs text-muted-foreground">
                Resolved dates:{" "}
                <span className="font-mono text-foreground">
                  {walkForwardResolvedStartFromSpec ?? "--"} - {walkForwardResolvedEndFromSpec ?? "--"}
                </span>
              </p>
            )}
          </CardContent>
        </Card>
      ) : (
        <Card>
          <CardContent className="py-16 text-center">
            <AlertCircle className="mx-auto mb-3 h-8 w-8 text-destructive" />
            <h3 className="font-semibold text-foreground">Run failed</h3>
            {run.error_message && (
              <pre className="mx-auto mt-3 max-w-xl overflow-auto rounded-lg border border-destructive/20 bg-destructive/5 p-3 text-left text-xs text-destructive">{run.error_message}</pre>
            )}
          </CardContent>
        </Card>
      )}
    </div>
  )
}
