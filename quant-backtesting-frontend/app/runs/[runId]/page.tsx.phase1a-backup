    }
  )

  const { data: metrics, isLoading: metricsLoading } = useMetrics(runReady ? runId : null)
  const { data: artifacts } = useArtifacts(runReady ? runId : null)
  const { data: decisions, isLoading: decisionsLoading } = useRunDecisions(
    runReady && !isSimpleWfoOptimization ? runId : null,
    { best_only: decisionBestOnly }
  )
  const { data: integrity } = useRunIntegrity(runReady ? runId : null)
  const { data: walkForward } = useRunWalkForward(runReady ? runId : null)
  const { data: significance } = useRunSignificance(runReady ? runId : null)
  const { data: risk } = useRunRisk(runReady ? runId : null)
  const { data: meanReversion } = useRunMeanReversion(runReady ? runId : null)

  useEffect(() => {
    const rows = artifacts ?? []
    const csvBySymbol = new Map<string, (typeof rows)[number]>()
    const heatBySymbol = new Map<string, (typeof rows)[number]>()

    for (const artifact of rows) {
      const symKey = artifactSymbolKey(artifact.symbol)
      if (
        artifact.artifact_type === "batch_period_csv" &&
        artifact.name === "batch_period.results" &&
        !csvBySymbol.has(symKey)
      ) {
        csvBySymbol.set(symKey, artifact)
      }
      if (
        artifact.artifact_type === "batch_period_plotly_json" &&
        artifact.name === "batch_period.heatmap" &&
        !heatBySymbol.has(symKey)
      ) {
        heatBySymbol.set(symKey, artifact)
      }
    }

    if (!csvBySymbol.size && !heatBySymbol.size) {
      setBatchPeriodRowsBySymbol({})
      setBatchPeriodHeatmapBySymbol({})
      setBatchPeriodLoading(false)
      return
    }

    let cancelled = false
    setBatchPeriodLoading(true)

    ;(async () => {
      const rowsBySymbol: Record<string, Array<Record<string, string>>> = {}
      const heatmapBySymbol: Record<string, PlotlyFigure> = {}

      await Promise.all(
        Array.from(csvBySymbol.entries()).map(async ([symbol, artifact]) => {
          try {
            const csv = await fetchArtifactText(artifact.url, artifact.object_key)
            rowsBySymbol[symbol] = parseCsvRecords(csv)
          } catch {
            rowsBySymbol[symbol] = []
          }
        })
      )

      await Promise.all(
        Array.from(heatBySymbol.entries()).map(async ([symbol, artifact]) => {
          try {
            const fig = await fetchArtifactJson(artifact.url, artifact.object_key)
            heatmapBySymbol[symbol] = fig
          } catch {
            // keep missing symbols absent
          }
        })
      )

      if (cancelled) return
      setBatchPeriodRowsBySymbol(rowsBySymbol)
      setBatchPeriodHeatmapBySymbol(heatmapBySymbol)
      setBatchPeriodLoading(false)
    })()

    return () => {
      cancelled = true
    }
  }, [artifacts])

  const symbols = useMemo(() => {
    const fromBest = (symbolRows ?? []).map((row) => row.symbol)
    const fromLeaderboard = (leaderboard ?? []).map((row) => row.symbol)
    const fromMetrics = (metrics ?? [])
      .map((row) => row.symbol)
      .filter((symbol): symbol is string => Boolean(symbol))
    const fromArtifacts = (artifacts ?? [])
      .map((artifact) => artifact.symbol)
      .filter((symbol): symbol is string => Boolean(symbol))
    const all = Array.from(new Set([...fromBest, ...fromLeaderboard, ...fromMetrics, ...fromArtifacts]))
    const realSymbols = all.filter((symbol) => symbol !== "__ALL__")
    return realSymbols.length > 0 ? realSymbols : all
  }, [artifacts, leaderboard, metrics, symbolRows])

  useEffect(() => {
    if (!symbols.length) {
      setSelectedSymbol(null)
      return
    }
    if (!selectedSymbol || !symbols.includes(selectedSymbol)) {
      setSelectedSymbol(symbols[0])
    }
  }, [selectedSymbol, symbols])

  const batchPeriodSymbols = useMemo(() => {
    const out = new Set<string>()
    for (const key of Object.keys(batchPeriodRowsBySymbol)) out.add(key)
    for (const key of Object.keys(batchPeriodHeatmapBySymbol)) out.add(key)
    return Array.from(out).sort((a, b) => a.localeCompare(b))
  }, [batchPeriodHeatmapBySymbol, batchPeriodRowsBySymbol])

  useEffect(() => {
    if (!batchPeriodSymbols.length) {
      setBatchPeriodSymbol(null)
      return
    }
    if (!batchPeriodSymbol || !batchPeriodSymbols.includes(batchPeriodSymbol)) {
      setBatchPeriodSymbol(batchPeriodSymbols[0])
    }
  }, [batchPeriodSymbol, batchPeriodSymbols])

  useEffect(() => {
    if (!isOptimizationRun) return
    setSelectedStockTab("overview")
    setSelectedDetailRowKey(null)
  }, [isOptimizationRun, selectedHorizon, selectedSymbol])

  const availableSimpleHorizons = useMemo(() => {
    if (!isSimpleWfoOptimization) return [] as SimpleHorizon[]
    const seen = new Set<SimpleHorizon>()
    for (const row of leaderboard ?? []) {
      const horizon = rowSimpleHorizon(row)
      if (horizon) seen.add(horizon)
    }
    if (seen.size === 0) {
      const raw = walkForwardSpecConfig?.horizons
      if (Array.isArray(raw)) {
        for (const item of raw) {
          const token = String(item ?? "").trim().toLowerCase()
          if (token === "short" || token === "medium" || token === "long") {
            seen.add(token)
          }
        }
      }
    }
    const out = Array.from(seen)
    out.sort((a, b) => SIMPLE_HORIZON_ORDER.indexOf(a) - SIMPLE_HORIZON_ORDER.indexOf(b))
    return out
  }, [isSimpleWfoOptimization, leaderboard, walkForwardSpecConfig?.horizons])

  useEffect(() => {
    if (!isSimpleWfoOptimization) {
      setSelectedHorizon(null)
      return
    }
    if (!availableSimpleHorizons.length) {
      setSelectedHorizon(null)
      return
    }
    if (!selectedHorizon || !availableSimpleHorizons.includes(selectedHorizon)) {
      setSelectedHorizon(availableSimpleHorizons[0])
    }
  }, [availableSimpleHorizons, isSimpleWfoOptimization, selectedHorizon])

  const horizonFilteredLeaderboard = useMemo(() => {
    const rows = leaderboard ?? []
    if (!isSimpleWfoOptimization || !selectedHorizon) return rows
    return rows.filter((row) => rowSimpleHorizon(row) === selectedHorizon)
  }, [isSimpleWfoOptimization, leaderboard, selectedHorizon])

  const visibleLeaderboard = useMemo(() => {
    const rows = horizonFilteredLeaderboard
    if (!symbolFilter.trim()) return rows
    const q = symbolFilter.trim().toLowerCase()
    return rows.filter((row) => row.symbol.toLowerCase().includes(q))
  }, [horizonFilteredLeaderboard, symbolFilter])

  const symbolSignals = useMemo(() => {
    const out = new Map<string, number>()
    const grouped = new Map<string, LeaderboardRow[]>()
    for (const row of symbolRows ?? []) {
      const prev = grouped.get(row.symbol) ?? []
      prev.push(row)
      grouped.set(row.symbol, prev)
    }
    for (const [symbol, rows] of grouped.entries()) {
      out.set(symbol, computeMajoritySignal(rows))
    }
    return out
  }, [symbolRows])

  const selectedSymbolBestRows = useMemo(() => {
    if (!selectedSymbol) return []
    if (isSimpleWfoOptimization) {
      const grouped = new Map<string, LeaderboardRow>()
      const rows = visibleLeaderboard.filter((row) => row.symbol === selectedSymbol)
      rows.sort((a, b) => {
        const rankA = rowDisplayRank(a) ?? 999999
        const rankB = rowDisplayRank(b) ?? 999999
        if (rankA !== rankB) return rankA - rankB
        return scoreOf(b.cagr) - scoreOf(a.cagr)
      })
      for (const row of rows) {
        if (!grouped.has(row.strategy_kind)) grouped.set(row.strategy_kind, row)
      }
      return Array.from(grouped.values())
    }
    const rows = (symbolRows ?? []).filter((row) => row.symbol === selectedSymbol)
    rows.sort((a, b) => scoreOf(b.cagr) - scoreOf(a.cagr))
    return rows
  }, [isSimpleWfoOptimization, selectedSymbol, symbolRows, visibleLeaderboard])

  const bestRowsByStrategy = useMemo(() => {
    const out = new Map<string, LeaderboardRow>()
    for (const row of selectedSymbolBestRows) {
      if (!out.has(row.strategy_kind)) {
        out.set(row.strategy_kind, row)
      }
    }
    return out
  }, [selectedSymbolBestRows])

  const selectedSymbolAllRows = useMemo(() => {
    if (!selectedSymbol) return []
    const rows = visibleLeaderboard.filter((row) => row.symbol === selectedSymbol)
    rows.sort((a, b) => {
      const rankA = rowDisplayRank(a) ?? 999999
      const rankB = rowDisplayRank(b) ?? 999999
      if (rankA !== rankB) return rankA - rankB
      return scoreOf(b.cagr) - scoreOf(a.cagr)
    })
    return rows
  }, [selectedSymbol, visibleLeaderboard])

  const strategyKindsForSelectedSymbol = useMemo(() => {
    return Array.from(new Set(selectedSymbolAllRows.map((row) => row.strategy_kind))).sort((a, b) =>
      a.localeCompare(b)
    )
  }, [selectedSymbolAllRows])

  const generalTop10Rows = useMemo(() => {
    const rows = [...visibleLeaderboard]
    rows.sort((a, b) => {
      const cagrDelta = scoreOf(b.cagr) - scoreOf(a.cagr)
      if (cagrDelta !== 0) return cagrDelta
      return scoreOf(b.pnl) - scoreOf(a.pnl)
    })
    return rows.slice(0, 10)
  }, [visibleLeaderboard])

  const selectedBatchPeriodSymbol = batchPeriodSymbol ?? batchPeriodSymbols[0] ?? null

  const selectedBatchPeriodRows = useMemo(() => {
    if (!selectedBatchPeriodSymbol) return []
    const rows = batchPeriodRowsBySymbol[selectedBatchPeriodSymbol] ?? []
    return [...rows].sort((a, b) => {
      const av = Number(a.objective_value ?? Number.NaN)
      const bv = Number(b.objective_value ?? Number.NaN)
      const an = Number.isFinite(av) ? av : -Infinity
      const bn = Number.isFinite(bv) ? bv : -Infinity
      return bn - an
    })
  }, [batchPeriodRowsBySymbol, selectedBatchPeriodSymbol])

  const selectedBatchPeriodHeatmap = useMemo(() => {
    if (!selectedBatchPeriodSymbol) return null
    return batchPeriodHeatmapBySymbol[selectedBatchPeriodSymbol] ?? null
  }, [batchPeriodHeatmapBySymbol, selectedBatchPeriodSymbol])

  const batchPeriodColumns = useMemo(() => {
    const row = selectedBatchPeriodRows[0]
    if (!row) return [] as string[]
    const keys = Object.keys(row)
    const front = [
      "period",
      "strategy_kind",
      "rank",
      "objective",
      "objective_value",
      "start",
      "end",
      "stat.pnl",
      "stat.cagr",
    ].filter((col) => keys.includes(col))
    const paramCols = keys
      .filter((col) => col.startsWith("param.strategy.") || col.startsWith("param.portfolio."))
      .slice(0, 6)
    const others = keys.filter((col) => !front.includes(col) && !paramCols.includes(col)).slice(0, 4)
    return [...front, ...paramCols, ...others]
  }, [selectedBatchPeriodRows])

  const filteredMetrics = useMemo(() => {
    const rows = metrics ?? []
    if (!separateBySymbol || !effectiveSymbol) return rows
    const symbolRowsMetric = rows.filter((row) => row.symbol === effectiveSymbol)
    if (symbolRowsMetric.length > 0) return symbolRowsMetric
    return rows.filter((row) => row.symbol === "__ALL__")
  }, [effectiveSymbol, metrics, separateBySymbol])

  const metricsBySymbol = useMemo(() => {
    const rows = metrics ?? []
    const grouped = new Map<string, typeof rows>()
    for (const symbol of symbols) {
      const exact = rows.filter((row) => row.symbol === symbol)
      if (exact.length > 0) {
        grouped.set(symbol, exact)
      } else {
        grouped.set(symbol, rows.filter((row) => row.symbol === "__ALL__"))
      }
    }
    return grouped
  }, [metrics, symbols])

  const selectedDetailRow = useMemo(() => {
    if (!selectedDetailRowKey) return null
    return selectedSymbolAllRows.find((row) => rowKey(row) === selectedDetailRowKey) ?? null
  }, [selectedDetailRowKey, selectedSymbolAllRows])

  const selectedSymbolBatchPeriodRows = useMemo(() => {
    if (!selectedSymbol) {
      return batchPeriodRowsBySymbol["__ALL__"] ?? []
    }
    return (
      batchPeriodRowsBySymbol[selectedSymbol] ??
      batchPeriodRowsBySymbol["__ALL__"] ??
      []
    )
  }, [batchPeriodRowsBySymbol, selectedSymbol])

  const detailGroupedParams = useMemo(() => {
    if (!selectedDetailRow) {
      return {
        strategy: {} as Record<string, unknown>,
        portfolio: {} as Record<string, unknown>,
      }
    }
    return extractGroupedParams(parseBestParams(selectedDetailRow.best_params_json))
  }, [selectedDetailRow])

  const detailMetricsRows = useMemo(() => {
    if (!selectedDetailRow) return []
    return metricsBySymbol.get(selectedDetailRow.symbol) ?? []
  }, [selectedDetailRow, metricsBySymbol])

  const selectedSymbolDecisionRows = useMemo(() => {
    if (!selectedSymbol) return []
    const rows = (decisions ?? []).filter((row) => row.symbol === selectedSymbol)
    rows.sort((a, b) => {
      const confidenceDelta = scoreOf(b.confidence_score) - scoreOf(a.confidence_score)
      if (confidenceDelta !== 0) return confidenceDelta
      const opportunityDelta = scoreOf(b.opportunity_score) - scoreOf(a.opportunity_score)
      if (opportunityDelta !== 0) return opportunityDelta
      return String(a.strategy_kind).localeCompare(String(b.strategy_kind))
    })
    return rows
  }, [decisions, selectedSymbol])

  useEffect(() => {
    setSelectedDecisionKey(null)
    setSelectedDecision(null)
    setSelectedDecisionDashboard(null)
  }, [selectedSymbol, decisionBestOnly, runId])

  useEffect(() => {
    if (!selectedSymbolDecisionRows.length) {
      setSelectedDecisionKey(null)
      setSelectedDecision(null)
      return
    }
    if (!selectedDecisionKey) {
      const first = selectedSymbolDecisionRows[0]
      setSelectedDecisionKey(decisionRowKey(first))
      setSelectedDecision(first)
      return
    }
    const match = selectedSymbolDecisionRows.find((row) => decisionRowKey(row) === selectedDecisionKey)
    if (!match) {
      const first = selectedSymbolDecisionRows[0]
      setSelectedDecisionKey(decisionRowKey(first))
      setSelectedDecision(first)
      return
    }
    if (!selectedDecision || decisionRowKey(selectedDecision) !== decisionRowKey(match)) {
      setSelectedDecision(match)
    }
  }, [selectedDecision, selectedDecisionKey, selectedSymbolDecisionRows])

  async function handleDecisionRowClick(row: StrategyDecision) {
    const key = decisionRowKey(row)
    setSelectedDecisionKey(key)
    setSelectedDecision(row)
    setSelectedDecisionDashboard(null)
  }

  useEffect(() => {
    if (!runId || !selectedDecision) return
    let canceled = false

    setDecisionDetailLoading(true)
    ;(async () => {
      try {
        const [full, dashboard] = await Promise.all([
          getRunDecision(
            runId,
            selectedDecision.symbol,
            selectedDecision.strategy_kind,
            selectedDecision.trial_id
          ),
          getRunDecisionDashboard(
            runId,
            selectedDecision.symbol,
            selectedDecision.strategy_kind,
            selectedDecision.trial_id
          ),
        ])
        if (canceled) return
        if (selectedDecisionKey && decisionRowKey(full) !== selectedDecisionKey) return
        setSelectedDecision(full)
        setSelectedDecisionDashboard(dashboard)
      } catch (err) {
        if (!canceled) {
          toast.error(
            `Failed to load decision detail: ${err instanceof Error ? err.message : "Unknown error"}`
          )
        }
      } finally {
        if (!canceled) setDecisionDetailLoading(false)
      }
    })()

    return () => {
      canceled = true
    }
  }, [runId, selectedDecisionKey, selectedDecision?.symbol, selectedDecision?.strategy_kind, selectedDecision?.trial_id])

  async function handleStart() {
    if (!runId) {
      toast.error("Missing run ID in route")
      return
    }
    setStarting(true)
    try {
      await startRun(runId)
      toast.success("Run started")
      mutateRun()
    } catch (err) {
      toast.error(`Failed to start: ${err instanceof Error ? err.message : "Unknown error"}`)
    } finally {
      setStarting(false)
    }
  }

  async function handleCancel() {
    if (!runId) return
    setCanceling(true)
    try {
      await cancelRun(runId)
      toast.success("Cancel requested")
      mutateRun()
    } catch (err) {
      toast.error(`Failed to cancel: ${err instanceof Error ? err.message : "Unknown error"}`)
    } finally {
      setCanceling(false)
    }
  }

  async function handleDelete() {
    if (!runId) return
    if (run?.status === "queued" || run?.status === "running" || run?.status === "cancel_requested") {
      toast.error("Cancel this active run before deleting it")
      return
    }
    const confirmed = window.confirm("Delete this run and all of its saved artifacts?")
    if (!confirmed) return

    setDeleting(true)
    try {
      await deleteRun(runId)
      toast.success("Run deleted")
      router.push("/")
    } catch (err) {
      toast.error(`Failed to delete: ${err instanceof Error ? err.message : "Unknown error"}`)
    } finally {
      setDeleting(false)
    }
  }

  if (runError) {
    return (
      <Card>
        <CardContent className="py-12 text-center">
          <AlertCircle className="mx-auto mb-3 h-8 w-8 text-destructive" />
          <h3 className="font-semibold text-foreground">Failed to load run</h3>
          <p className="mt-1 text-sm text-muted-foreground">{String(runError.message || runError)}</p>
        </CardContent>
      </Card>
    )
  }

  if (!run) {
    return (
      <div className="space-y-4">
        <Skeleton className="h-32 rounded-xl" />
        <Skeleton className="h-64 rounded-xl" />
      </div>
    )
  }

  return (
    <div className="space-y-4">
      <RunHeader
        run={run}
        onStart={handleStart}
        onCancel={handleCancel}
        onDelete={handleDelete}
        onRefresh={() => mutateRun()}
        starting={starting}
        canceling={canceling}
        deleting={deleting}
      />

      {run.status === "succeeded" ? (
        <div className="grid gap-4 lg:grid-cols-[240px_minmax(0,1fr)]">
          <Card className="h-fit lg:sticky lg:top-4">
            <CardHeader className="pb-2">
              <CardTitle className="text-base">Symbols</CardTitle>
            </CardHeader>
            <CardContent className="space-y-2">
              {isOptimizationRun ? (
                <>
                  <Button
                    variant={showOptimizationGeneral ? "default" : "outline"}
                    className="h-8 w-full text-xs"
                    onClick={() => {
                      setShowOptimizationGeneral(true)
                      setSelectedDetailRowKey(null)
                    }}
                  >
                    General Results
                  </Button>
                  {symbolRowsLoading ? (
                    <Skeleton className="h-24 rounded-md" />
                  ) : symbols.length === 0 ? (
                    <p className="text-xs text-muted-foreground">No symbol data found.</p>
                  ) : (
                    <div className="space-y-1">
                      {symbols.map((symbol) => {
                        const active = !showOptimizationGeneral && selectedSymbol === symbol
                        return (
                          <button
                            key={symbol}
                            onClick={() => {
                              setSelectedSymbol(symbol)
                              setShowOptimizationGeneral(false)
                            }}
                            className={`flex w-full items-center justify-between rounded-md border px-2 py-1.5 text-left text-xs transition-colors ${
                              active
                                ? "border-primary bg-primary/5"
                                : "border-border hover:bg-secondary/40"
                            }`}
                          >
                            <span className="font-mono font-semibold text-foreground">{symbol}</span>
                            <SignalBadge value={symbolSignals.get(symbol) ?? 0} />
                          </button>
                        )
                      })}
                    </div>
                  )}
                </>
              ) : (
                <>
                  <div className="flex items-center justify-between rounded-md border border-border px-2 py-1.5">
                    <Label htmlFor="separate-by-symbol" className="text-xs text-muted-foreground">
                      Separate by symbol
                    </Label>
                    <Switch
                      id="separate-by-symbol"
                      checked={separateBySymbol}
                      onCheckedChange={setSeparateBySymbol}
                    />
                  </div>
                  {symbolRowsLoading ? (
                    <Skeleton className="h-24 rounded-md" />
                  ) : symbols.length === 0 ? (
                    <p className="text-xs text-muted-foreground">No symbol data found.</p>
                  ) : (
                    <div className="space-y-1">
                      {symbols.map((symbol) => {
                        const active = selectedSymbol === symbol
                        return (
                          <button
                            key={symbol}
                            onClick={() => setSelectedSymbol(symbol)}
                            disabled={!separateBySymbol}
                            className={`flex w-full items-center justify-between rounded-md border px-2 py-1.5 text-left text-xs transition-colors ${
                              active && separateBySymbol
                                ? "border-primary bg-primary/5"
                                : "border-border hover:bg-secondary/40"
                            } ${!separateBySymbol ? "opacity-60" : ""}`}
                          >
                            <span className="font-mono font-semibold text-foreground">{symbol}</span>
                            <SignalBadge value={symbolSignals.get(symbol) ?? 0} />
                          </button>
                        )
                      })}
                    </div>
                  )}
                </>
              )}
            </CardContent>
          </Card>

          <div className="space-y-4">
            <div className="grid gap-3 xl:grid-cols-4">
              <Card>
                <CardHeader className="pb-2">
                  <CardTitle className="text-sm">Integrity</CardTitle>
                </CardHeader>
                <CardContent className="space-y-2 text-xs">
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">Status</span>
                    <span
                      className={`rounded px-2 py-0.5 font-semibold uppercase ${
                        (integrity?.integrity_status ?? run.integrity_status) === "fail"
                          ? "bg-destructive/15 text-destructive"
                          : (integrity?.integrity_status ?? run.integrity_status) === "warn"
                            ? "bg-amber-500/15 text-amber-600"
                            : "bg-emerald-500/15 text-emerald-600"
                      }`}
                    >
                      {(integrity?.integrity_status ?? run.integrity_status ?? "--").toString()}
                    </span>
                  </div>
                  {(integrity?.checks ?? []).slice(0, 4).map((check) => (
                    <div key={check.check_name} className="flex items-center justify-between border-b border-border/50 pb-1 last:border-0">
                      <span className="text-muted-foreground">{check.check_name}</span>
                      <span className="font-mono uppercase">{check.status}</span>
                    </div>
                  ))}
                </CardContent>
              </Card>

              <Card>
                <CardHeader className="pb-2">
                  <CardTitle className="text-sm">Significance</CardTitle>
                </CardHeader>
                <CardContent className="space-y-2 text-xs">
                  {!(significance ?? []).length ? (
                    <p className="text-muted-foreground">Not computed.</p>
                  ) : (
                    (significance ?? []).slice(0, 4).map((row) => (
                      <div key={row.method} className="border-b border-border/50 pb-1 last:border-0">
                        <p className="font-mono text-[11px]">{row.method}</p>
                        <p className="text-muted-foreground">
                          p={formatNumber(row.pvalue, 4)} | stat={formatNumber(row.statistic, 4)}
                        </p>
                      </div>
                    ))
                  )}
                </CardContent>
              </Card>

              <Card>
                <CardHeader className="pb-2">
                  <CardTitle className="text-sm">Risk / Leverage</CardTitle>
                </CardHeader>
                <CardContent className="space-y-1 text-xs">
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">Kelly</span>
                    <span className="font-mono">{formatNumber(risk?.risk?.kelly_fraction, 3)}</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">Half-Kelly</span>
                    <span className="font-mono">{formatNumber(risk?.risk?.half_kelly, 3)}</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">Chosen Lev.</span>
                    <span className="font-mono">{formatNumber(risk?.risk?.chosen_leverage, 3)}</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">MC DD p95</span>
                    <span className="font-mono">{formatPercent(risk?.risk?.mc_drawdown_pctl)}</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">MC VaR</span>
                    <span className="font-mono">{formatPercent(risk?.risk?.mc_var)}</span>
                  </div>
                  <div className="flex items-center justify-between">
                    <span className="text-muted-foreground">MC CVaR</span>
                    <span className="font-mono">{formatPercent(risk?.risk?.mc_cvar)}</span>
                  </div>
                </CardContent>
              </Card>

              <Card>
                <CardHeader className="pb-2">
                  <CardTitle className="text-sm">Mean-Reversion</CardTitle>
                </CardHeader>
                <CardContent className="text-xs">
                  {meanReversion?.report_url ? (
                    <a
                      href={meanReversion.report_url}
                      target="_blank"
                      rel="noreferrer"
                      className="text-primary underline underline-offset-2"
                    >
                      Open diagnostics report
