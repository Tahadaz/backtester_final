type DecisionLayer = StrategyDecision["opportunity_subscores"][string]
type LayerDisplayRow = { label: string; value: string }
type OpportunityLayerKey = "regime" | "direction" | "confirmation" | "timing" | "risk"

const OPPORTUNITY_LAYER_ORDER: OpportunityLayerKey[] = [
  "regime",
  "direction",
  "confirmation",
  "timing",
  "risk",
]

const OPPORTUNITY_LAYER_LABELS: Record<OpportunityLayerKey, string> = {
  regime: "Regime",
  direction: "Direction",
  confirmation: "Confirmation",
  timing: "Timing",
  risk: "Risk",
}

function asObject(value: unknown): Record<string, unknown> | null {
  if (!value || typeof value !== "object" || Array.isArray(value)) return null
  return value as Record<string, unknown>
}

function toFiniteNumber(value: unknown): number | null {
  if (typeof value === "number" && Number.isFinite(value)) return value
  if (typeof value === "string") {
    const trimmed = value.trim()
    if (!trimmed) return null
    const parsed = Number(trimmed)
    if (Number.isFinite(parsed)) return parsed
  }
  return null
}

function toBoolean(value: unknown): boolean | null {
  if (typeof value === "boolean") return value
  if (typeof value === "number") return value !== 0
  if (typeof value === "string") {
    const lowered = value.trim().toLowerCase()
    if (["true", "1", "yes", "y", "on"].includes(lowered)) return true
    if (["false", "0", "no", "n", "off"].includes(lowered)) return false
  }
  return null
}

function formatRawValue(value: unknown, decimals = 4): string {
  const num = toFiniteNumber(value)
  if (num !== null) return formatNumber(num, decimals)
  if (typeof value === "boolean") return value ? "TRUE" : "FALSE"
  if (value === null || value === undefined) return "--"
  if (typeof value === "string") return value.trim() || "--"
  try {
    return JSON.stringify(value)
  } catch {
    return String(value)
  }
}

function formatPctRatio(value: unknown, decimals = 2): string {
  const num = toFiniteNumber(value)
  if (num === null) return "--"
  return `${formatNumber(num * 100, decimals)}%`
}

function formatDirectionValue(value: unknown): string {
  const num = toFiniteNumber(value)
  if (num === null) return formatRawValue(value)
  if (num > 0) return "LONG (+1)"
  if (num < 0) return "SHORT (-1)"
  return "NEUTRAL (0)"
}

function formatRegimeBias(value: unknown): string {
  const num = toFiniteNumber(value)
  if (num === null) return formatRawValue(value)
  if (num > 0) return "BULLISH (+1)"
  if (num < 0) return "BEARISH (-1)"
  return "NEUTRAL (0)"
}

function decisionLayers(
  row: StrategyDecision,
  kind: "opportunity" | "confidence"
): Record<string, DecisionLayer> {
  const fromPage = row.decision_page[kind]?.layers ?? {}
  const fallback = kind === "opportunity" ? row.opportunity_subscores : row.confidence_subscores
  return Object.keys(fromPage).length ? fromPage : fallback
}

function decisionLayerEntries(
  row: StrategyDecision,
  kind: "opportunity" | "confidence"
): Array<[string, DecisionLayer]> {
  const layers = decisionLayers(row, kind)
  return Object.entries(layers).sort(([a], [b]) => a.localeCompare(b))
}

function orderedOpportunityLayers(
  row: StrategyDecision
): Array<{ key: OpportunityLayerKey; layer: DecisionLayer | null }> {
  const layers = decisionLayers(row, "opportunity")
  return OPPORTUNITY_LAYER_ORDER.map((key) => ({ key, layer: layers[key] ?? null }))
}

function opportunityFactorRows(
  row: StrategyDecision,
  key: OpportunityLayerKey,
  layer: DecisionLayer | null
): LayerDisplayRow[] {
  const inputs = asObject(layer?.inputs) ?? {}
  const thresholds = asObject(layer?.thresholds) ?? {}

  if (key === "regime") {
    return [
      { label: "Regime Label", value: formatRawValue(inputs.label, 0) },
      { label: "Regime Bias", value: formatRegimeBias(inputs.bias) },
      { label: "Price", value: formatRawValue(inputs.price) },
      { label: "SMA200", value: formatRawValue(inputs.sma200) },
      { label: "SMA200 Slope (20)", value: formatPctRatio(inputs.sma200_slope_pct_20) },
      { label: "ADX", value: formatRawValue(inputs.adx, 2) },
    ]
  }

  if (key === "direction") {
    const strategyDirection = toFiniteNumber(inputs.strategy_direction)
    const regimeBias = toFiniteNumber(inputs.regime_bias)
    let alignment = "--"
    if (strategyDirection === 0) alignment = "Neutral signal"
    else if (regimeBias === 0) alignment = "Neutral regime"
    else if (strategyDirection === regimeBias) alignment = "Aligned"
    else alignment = "Conflicting"
    return [
      { label: "Strategy Direction", value: formatDirectionValue(inputs.strategy_direction) },
      { label: "Regime Bias", value: formatRegimeBias(inputs.regime_bias) },
      { label: "Alignment", value: alignment },
      { label: "Strategy Kind", value: formatRawValue(inputs.strategy_kind, 0) },
    ]
  }

  if (key === "confirmation") {
    const met = toFiniteNumber(inputs.met)
    const total = toFiniteNumber(inputs.total)
    const required = toFiniteNumber(inputs.required)
    const ratio = (met !== null && total !== null && total > 0) ? met / total : null
    return [
      {
        label: "Checks Passed",
        value:
          met !== null && total !== null
            ? `${formatNumber(met, 0)} / ${formatNumber(total, 0)}`
            : "--",
      },
      {
        label: "Minimum Required",
        value: required !== null ? formatNumber(required, 0) : "--",
      },
      { label: "Pass Ratio", value: ratio !== null ? formatPctRatio(ratio) : "--" },
      { label: "High Quality Threshold", value: formatPctRatio(thresholds.high_quality_ratio) },
    ]
  }

  if (key === "timing") {
    return [
      { label: "Distance to SMA100", value: formatPctRatio(inputs.distance_to_sma100_pct) },
      { label: "Support", value: formatRawValue(inputs.support) },
      { label: "Resistance", value: formatRawValue(inputs.resistance) },
      { label: "High Threshold", value: formatPctRatio(thresholds.high) },
      { label: "Medium Threshold", value: formatPctRatio(thresholds.medium) },
    ]
  }

  return [
    { label: "RR", value: formatNumber(row.decision_page.risk.rr, 2) },
    { label: "Risk / Share", value: formatRawValue(row.decision_page.risk.risk_per_share) },
    { label: "Reward / Share", value: formatRawValue(row.decision_page.risk.reward_per_share) },
    { label: "Entry", value: formatRawValue(inputs.entry) },
    { label: "Stop", value: formatRawValue(inputs.stop) },
    { label: "Target", value: formatRawValue(inputs.target) },
    { label: "Direction", value: formatDirectionValue(inputs.direction) },
    { label: "RR High Threshold", value: formatRawValue(thresholds.high, 2) },
  ]
}

function opportunityConfirmationChecks(layer: DecisionLayer | null): Array<{ name: string; passed: boolean }> {
  const inputs = asObject(layer?.inputs)
  const checks = asObject(inputs?.checks)
  if (!checks) return []
  return Object.entries(checks).map(([name, raw]) => ({
    name,
    passed: toBoolean(raw) === true,
  }))
}

function confidenceInputRows(layer: DecisionLayer, limit = 3): LayerDisplayRow[] {
  const out: LayerDisplayRow[] = []
  const inputs = asObject(layer.inputs) ?? {}
  for (const [name, raw] of Object.entries(inputs)) {
    if (raw !== null && typeof raw === "object") continue
    out.push({ label: name, value: formatRawValue(raw) })
    if (out.length >= limit) break
  }
  return out
}

