function computeMajoritySignal(rows: LeaderboardRow[]): number {
  let buys = 0
  let sells = 0
  let holds = 0
  for (const row of rows) {
    const signal = row.signal_today ?? 0
    if (signal > 0) buys += 1
    else if (signal < 0) sells += 1
    else holds += 1
  }
  if (buys > sells && buys > holds) return 1
  if (sells > buys && sells > holds) return -1
  return 0
}

