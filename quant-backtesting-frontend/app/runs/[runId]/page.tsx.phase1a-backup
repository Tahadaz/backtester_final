function parseBestParams(raw: unknown): Record<string, unknown> {
  if (!raw) return {}
  if (typeof raw === "string") {
    try {
      const parsed = JSON.parse(raw) as unknown
      if (parsed && typeof parsed === "object" && !Array.isArray(parsed)) {
        return parsed as Record<string, unknown>
      }
    } catch {
      return {}
    }
    return {}
  }
  if (typeof raw === "object" && !Array.isArray(raw)) {
    return raw as Record<string, unknown>
  }
  return {}
}

function nestedRecordField(
  parent: Record<string, unknown>,
  key: string
): Record<string, unknown> {
  const value = parent[key]
  if (value && typeof value === "object" && !Array.isArray(value)) {
    return value as Record<string, unknown>
  }
  return {}
}

function flattenRecord(
  value: Record<string, unknown>,
  prefix = "",
  out: Record<string, unknown> = {}
): Record<string, unknown> {
  for (const [key, raw] of Object.entries(value)) {
    const nextKey = prefix ? `${prefix}.${key}` : key
    if (raw && typeof raw === "object" && !Array.isArray(raw)) {
      flattenRecord(raw as Record<string, unknown>, nextKey, out)
      continue
    }
    out[nextKey] = raw
  }
  return out
}

function setByPath(target: Record<string, unknown>, dottedPath: string, value: unknown) {
  const parts = dottedPath.split(".").map((p) => p.trim()).filter(Boolean)
  if (!parts.length) return

  let current: Record<string, unknown> = target
  for (let i = 0; i < parts.length; i += 1) {
    const part = parts[i]
    if (i === parts.length - 1) {
      current[part] = value
      return
    }
    const next = current[part]
    if (!next || typeof next !== "object" || Array.isArray(next)) {
      const created: Record<string, unknown> = {}
      current[part] = created
      current = created
      continue
    }
    current = next as Record<string, unknown>
  }
}

function extractGroupedParams(params: Record<string, unknown>): {
  strategy: Record<string, unknown>
  portfolio: Record<string, unknown>
} {
  const strategyNested = flattenRecord(nestedRecordField(params, "strategy"))
  const portfolioNested = flattenRecord(nestedRecordField(params, "portfolio"))
  const strategyFlat: Record<string, unknown> = {}
  const portfolioFlat: Record<string, unknown> = {}

  for (const [key, val] of Object.entries(params)) {
    if (key.startsWith("strategy.")) {
      strategyFlat[key.slice("strategy.".length)] = val
      continue
    }
    if (key.startsWith("portfolio.")) {
      setByPath(portfolioFlat, key.slice("portfolio.".length), val)
    }
  }

  for (const [key, val] of Object.entries(portfolioNested)) {
    setByPath(portfolioFlat, key, val)
  }

  return {
    strategy: { ...strategyFlat, ...strategyNested },
    portfolio: portfolioFlat,
  }
}

function bestParamsPreview(raw: unknown): string {
  const entries = flattenDisplayParams(raw)
  if (!entries.length) return "--"
  return entries
    .slice(0, 6)
    .map(([k, v]) => `${k}=${v}`)
    .join(", ")
}

function stringifyParamValue(value: unknown): string {
  if (value === null) return "null"
  if (value === undefined) return "undefined"
  if (typeof value === "number") return Number.isFinite(value) ? String(value) : "--"
  if (typeof value === "boolean") return value ? "true" : "false"
  if (typeof value === "string") return value
  try {
    return JSON.stringify(value)
  } catch {
    return String(value)
  }
}

function flattenDisplayParams(raw: unknown): Array<[string, string]> {
  const flattened = flattenRecord(parseBestParams(raw))
  return Object.entries(flattened)
    .filter(([key]) => Boolean(key) && !key.startsWith("_"))
    .map(([key, value]) => [key, stringifyParamValue(value)] as [string, string])
    .sort(([left], [right]) => left.localeCompare(right))
}

function bestParamsDiffPreview(raw: unknown, baselineRaw: unknown): string {
  const current = new Map(flattenDisplayParams(raw))
  const baseline = new Map(flattenDisplayParams(baselineRaw))

  const keys = Array.from(new Set([...current.keys(), ...baseline.keys()])).sort((a, b) =>
    a.localeCompare(b)
  )
  const diffs: string[] = []
  for (const key of keys) {
    const value = current.get(key)
    const base = baseline.get(key)
    if (value === base) continue
    if (value === undefined) {
      diffs.push(`${key}=<removed>`)
      continue
    }
    if (base === undefined) {
      diffs.push(`${key}=+${value}`)
      continue
    }
    diffs.push(`${key}=${value} (vs ${base})`)
  }
  if (!diffs.length) return "same as rank #1"
  return diffs.slice(0, 6).join(", ")
}

// Strategy-only param helpers — show only the strategy-level params (e.g. SMA window)
// rather than the full flattened set which includes portfolio config.
function strategyOnlyEntries(raw: unknown): Array<[string, string]> {
  const obj = parseBestParams(raw)
  const strategyNested = flattenRecord(nestedRecordField(obj, "strategy"))
  const strategyFlat: Record<string, unknown> = {}
  for (const [key, val] of Object.entries(obj)) {
    if (key.startsWith("strategy.")) {
      strategyFlat[key.slice("strategy.".length)] = val
    }
  }
  const merged = { ...strategyFlat, ...strategyNested }
  return Object.entries(merged)
    .filter(([key]) => Boolean(key) && !key.startsWith("_"))
    .map(([key, value]) => [key, stringifyParamValue(value)] as [string, string])
    .sort(([left], [right]) => left.localeCompare(right))
}

function strategyOnlyPreview(raw: unknown): string {
  const entries = strategyOnlyEntries(raw)
  if (!entries.length) return bestParamsPreview(raw)
  return entries.slice(0, 3).map(([k, v]) => `${k}=${v}`).join(", ")
}

function strategyOnlyDiffPreview(raw: unknown, baselineRaw: unknown): string {
  const current = new Map(strategyOnlyEntries(raw))
  const baseline = new Map(strategyOnlyEntries(baselineRaw))
  if (!current.size && !baseline.size) return bestParamsDiffPreview(raw, baselineRaw)
  const keys = Array.from(new Set([...current.keys(), ...baseline.keys()])).sort((a, b) =>
    a.localeCompare(b)
  )
  const diffs: string[] = []
  for (const key of keys) {
    const value = current.get(key)
    const base = baseline.get(key)
    if (value === base) continue
    if (value === undefined) { diffs.push(`${key}=<removed>`); continue }
    if (base === undefined) { diffs.push(`${key}=+${value}`); continue }
    diffs.push(`${key}=${value} (vs ${base})`)
  }
  if (!diffs.length) return "same as rank #1"
  return diffs.slice(0, 3).join(", ")
}

// Extract a numeric metric from fold_metrics_json which may use flat or nested dot-path keys.
// Tries each key in order, returns first finite number found, or null.
function foldMetric(m: Record<string, unknown>, ...keys: string[]): number | null {
  for (const key of keys) {
    const val = key.split(".").reduce<unknown>(
      (o, k) => (o !== null && o !== undefined && typeof o === "object" ? (o as Record<string, unknown>)[k] : undefined),
      m
    )
    if (val !== null && val !== undefined && Number.isFinite(Number(val))) return Number(val)
  }
  return null
}

// Stable recipe identity key derived from strategy-only params.
function recipeKeyFor(params: unknown): string {
  const entries = strategyOnlyEntries(params)
  return entries.length ? entries.map(([k, v]) => `${k}=${v}`).join("|") : "__all__"
}

// Compact portfolio/overlay param display string (max 4 key=value pairs).
function overlayCompact(params: unknown): string {
  const { portfolio } = extractGroupedParams(parseBestParams(params))
  const flat = flattenRecord(portfolio)
  const entries = Object.entries(flat).filter(([k]) => !k.startsWith("_")).slice(0, 4)
  if (!entries.length) return "(default overlay)"
  return entries.map(([k, v]) => `${k}=${stringifyParamValue(v)}`).join(", ")
}

// Badge classification for a single OOS fold period.
// maxDD is expected as a fraction (e.g. -0.15 = -15%).
function foldPeriodBadge(
  pnl: number | null,
  sharpe: number | null,
  maxDD: number | null
): { label: string; cls: string } {
  if (pnl === null) return { label: "—", cls: "bg-secondary text-muted-foreground" }
  if (pnl > 0 && (sharpe ?? 0) > 1.0) return { label: "Strong", cls: "bg-emerald-100 text-emerald-800" }
  if (pnl > 0) return { label: "Pass", cls: "bg-blue-100 text-blue-800" }
  if (Math.abs(maxDD ?? 0) < 0.20) return { label: "Weak", cls: "bg-amber-100 text-amber-800" }
  return { label: "Fail", cls: "bg-red-100 text-red-800" }
}

