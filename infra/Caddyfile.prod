# OCI production edge proxy.
{
    email taha.dazine@gmail.com
    servers {
        protocols h1 h2 h3
    }
}

{$DOMAIN} {
    @allowed {
        remote_ip 127.0.0.1/32 172.16.0.0/12 {$ALLOWED_REMOTE_IPS:197.230.23.178/32}
    }
    @bridge_allowed {
        path /bridge/bloomberg/*
        remote_ip 127.0.0.1/32 172.16.0.0/12 {$ALLOWED_REMOTE_IPS:197.230.23.178/32}
    }
    handle @bridge_allowed {
        reverse_proxy quant_api:8000
    }
    handle @allowed {
        reverse_proxy quant_frontend:3000
    }
    handle {
        respond "Forbidden" 403
    }
    encode gzip zstd
    tls {
        protocols tls1.2 tls1.3
    }
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        -Server
    }
}
