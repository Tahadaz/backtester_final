# ---- Data / Artifacts (VERY IMPORTANT) ----
data/
# Whitelist: source code directories literally named "data"
!frontend/app/data/
!frontend/components/data/
# Whitelist: static JSON datasets shipped with the dashboard (used by GH Pages build)
!frontend/public/data/
!frontend/public/data/**
datasets/
artifacts/
# Whitelist: Python package literally named "artifacts" (core runtime code, not build output)
!core/quant_core/artifacts/
!core/quant_core/artifacts/**
*.csv
*.xlsx
*.xls
*.parquet
*.pkl
*.pickle

# ---- Local infra volumes ----
minio/
postgres/
redis/
docker-data/

# ---- IDE ----
.vscode/
.idea/

